load("@rules_python//python:defs.bzl", "py_binary", "py_library")

# Library containing the TUI logic and components
py_library(
    name = "dev_tui_lib",
    srcs = glob(
        ["**/*.py"],
        exclude = ["main.py", "tests/**"],
    ),
    visibility = ["//visibility:public"],
    deps = [
        # Dependencies are managed via uv and referenced from the central requirements
        # "@python_deps//textual",
        # "@python_deps//click",
    ],
)

# Main entry point for the development TUI
py_binary(
    name = "dev_tui",
    srcs = ["main.py"],
    main = "main.py",
    deps = [
        ":dev_tui_lib",
    ],
)
