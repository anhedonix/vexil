{
  "name": "vexil",
  "description": "Houdini centric project management system",
  "private": true,
  "tasks": {
    "dev": "turbo run dev",
    "setup": "(cd apps/backend-api && uv sync) && (cd apps/plugins/houdini-package && uv sync) && (cd dev-tools/env-init && uv sync)"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "turbo": "^2.9.12"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "dev-tools/*",
    "apps/plugins/*"
  ] 
}