{
  "name": "vexil",
  "version": "0.1.2",
  "description": "Houdini centric project management system",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "setup": "(cd apps/vexil-package-src && uv sync) && (cd apps/vexil-dev-tools/env-init && uv sync) && (cd apps/vexil-io && go mod download)"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "turbo": "^2.10.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "apps/vexil-dev-tools/*"
  ]
}
