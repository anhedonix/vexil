---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'VEXiL - Pipeline-Aware Project Management for Houdini',
  description =
    'VEXiL is a Houdini-first project management environment for VFX freelancers, indie studios, and TDs - pipeline-aware depth for sequences, frame ranges, and dependency graphs.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#00B4FF" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('vexil-theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: light)').matches
                ? 'light'
                : 'dark';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (_) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body id="top" class="bg-base text-primary font-sans overflow-x-hidden grain">
    <!-- Ambient radial wash (mood-board depth; lighter tint in light theme) -->
    <div class="fixed inset-0 z-0 pointer-events-none ambient-wash" aria-hidden="true">
      <div class="absolute inset-0 ambient-wash-gradient"></div>
    </div>
    <style is:global>
      .ambient-wash-gradient {
        background: radial-gradient(
          ellipse 80% 50% at 50% -10%,
          color-mix(in srgb, #00b4ff 12%, transparent),
          transparent 60%
        );
      }
      [data-theme='light'] .ambient-wash-gradient {
        background: radial-gradient(
          ellipse 80% 50% at 50% -10%,
          color-mix(in srgb, #00b4ff 15%, transparent),
          transparent 60%
        );
      }
    </style>

    <div class="relative z-10">
      <slot />
    </div>
  </body>
</html>
