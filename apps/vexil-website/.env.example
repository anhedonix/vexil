# Resend (https://resend.com) - used by /api/waitlist to email submissions
# All three are required for the waitlist form to work; otherwise the endpoint
# returns 503 and the form shows an error.

# Your Resend API key (starts with `re_...`)
RESEND_API_KEY=

# The verified-domain "from" address. Must be a sender that Resend has
# verified for your account, e.g. "VEXiL Waitlist <waitlist@yourdomain.com>"
RESEND_FROM_EMAIL=

# Where waitlist submissions should be delivered.
RESEND_TO_EMAIL=

# Optional: canonical site URL used for sitemap / SEO.
# SITE_URL=https://vexil.tools
