---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'VEXiL — Houdini Project Management',
  description = 'VEXiL is a consolidated project management environment designed specifically for SideFX Houdini artists and small studios.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="bg-slate-950 text-slate-200 font-sans selection:bg-purple-500/30 overflow-x-hidden">
    <!-- Ambient Background Gradients -->
    <div class="fixed inset-0 z-0 pointer-events-none opacity-40">
      <div
        class="absolute top-[-10%] left-[-10%] w-[500px] h-[500px] bg-purple-600/30 rounded-full blur-[100px] animate-float"
      >
      </div>
      <div
        class="absolute top-[20%] right-[-5%] w-[600px] h-[600px] bg-cyan-500/20 rounded-full blur-[120px] animate-float-delayed"
      >
      </div>
      <div
        class="absolute bottom-[-10%] left-[20%] w-[700px] h-[700px] bg-fuchsia-500/20 rounded-full blur-[150px] animate-float"
      >
      </div>
    </div>

    <slot />
  </body>
</html>
