---
import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

const repoTree = `<span class="text-cyan-400">vexil/</span>
├── <span class="text-purple-400">apps/</span>
│   ├── <span class="text-emerald-400">website/</span>          <span class="text-slate-500">— marketing site (Astro 6 · Tailwind v4)</span>
│   ├── <span class="text-emerald-400">frontend/</span>         <span class="text-slate-500">— product web UI (Astro 6)</span>
│   ├── <span class="text-emerald-400">backend/</span>          <span class="text-slate-500">— core API (Django 6 · uv · Python ≥3.14)</span>
│   └── <span class="text-emerald-400">houdini-package/</span>  <span class="text-slate-500">— Houdini plugin (uv · Python 3.11)</span>
├── <span class="text-purple-400">tools/</span>
│   └── <span class="text-emerald-400">dev-tui/</span>          <span class="text-slate-500">— developer TUI (uv · Python ≥3.14)</span>
└── <span class="text-purple-400">infrastructure/</span>     <span class="text-slate-500">— deployment & IaC (planned)</span>`;

const quickstart = `<span class="text-slate-500"># 1. Clone and hydrate the JS workspaces</span>
git clone https://github.com/anhedonix/vexil
cd vexil
bun install

<span class="text-slate-500"># 2. Run every dev server in parallel (Turborepo)</span>
bun run dev

<span class="text-slate-500"># 3. Python workspaces — uv handles each one</span>
cd apps/backend          && uv sync && uv run manage.py runserver
cd apps/houdini-package  && uv sync
cd tools/dev-tui         && uv sync`;
---

<Layout>
  <!-- Navigation -->
  <nav class="border-b border-white/5 bg-slate-950/40 backdrop-blur-xl sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div
          class="w-8 h-8 rounded-lg bg-gradient-to-br from-cyan-400 to-purple-600 flex items-center justify-center font-bold text-white shadow-[0_0_15px_rgba(168,85,247,0.4)]"
        >
          V
        </div>
        <span class="font-bold text-xl tracking-wide text-white">VEXiL</span>
      </div>
      <div class="flex items-center gap-6 text-sm font-medium">
        <a href="#features" class="hover:text-cyan-400 transition-colors hidden sm:block">Features</a>
        <a href="#deployment" class="hover:text-cyan-400 transition-colors hidden sm:block">Deployment</a>
        <a
          href="https://github.com/anhedonix/vexil"
          target="_blank"
          rel="noreferrer"
          class="flex items-center gap-2 bg-white/5 hover:bg-white/10 border border-white/10 text-white px-4 py-2 rounded-lg transition-all shadow-sm"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"
            ><path
              d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
            ></path></svg
          >
          <span>GitHub</span>
        </a>
      </div>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="relative pt-24 pb-32 px-6">
    <div class="max-w-4xl mx-auto text-center relative z-10 flex flex-col items-center">
      <!-- Beta Badge -->
      <div
        class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gradient-to-r from-cyan-500/10 to-purple-500/10 border border-purple-500/20 text-purple-300 text-sm font-medium mb-8 shadow-[0_0_10px_rgba(168,85,247,0.2)]"
      >
        <Icon name="lucide:sparkles" class="w-4 h-4 text-cyan-400" />
        <span>Currently under development. Public beta testing coming soon.</span>
      </div>

      <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight text-white mb-6 leading-tight">
        Project Management, <br />
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-blue-500 to-purple-500">
          Tailored Exclusively for Houdini.
        </span>
      </h1>

      <p class="text-lg md:text-xl text-slate-300 mb-10 max-w-2xl leading-relaxed">
        VEXiL is a consolidated project management environment designed specifically to solve the organizational
        bottlenecks of individual artists and small teams using SideFX Houdini.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
        <a
          href="#waitlist"
          class="group flex items-center justify-center gap-2 bg-gradient-to-r from-cyan-500 via-blue-500 to-purple-600 hover:from-cyan-400 hover:via-blue-400 hover:to-purple-500 text-white px-8 py-3.5 rounded-xl font-bold transition-all shadow-[0_0_20px_rgba(168,85,247,0.4)] hover:shadow-[0_0_30px_rgba(34,211,238,0.5)] hover:-translate-y-0.5"
        >
          Join the Waitlist
          <Icon name="lucide:chevron-down" class="w-[18px] h-[18px] group-hover:translate-y-1 transition-transform" />
        </a>
        <a
          href="https://github.com/anhedonix/vexil"
          target="_blank"
          rel="noreferrer"
          class="flex items-center justify-center gap-2 bg-white/5 hover:bg-white/10 border border-white/10 text-white px-8 py-3.5 rounded-xl font-bold transition-all hover:-translate-y-0.5"
        >
          <svg
            class="w-[18px] h-[18px] fill-current"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            ><path
              d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
            ></path></svg
          >
          View Source on GitHub
        </a>
      </div>

      <!-- Quick Stats -->
      <div class="mt-16 w-full grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
        <div class="bg-white/[0.02] border border-white/5 p-5 rounded-2xl backdrop-blur-sm">
          <span class="text-[10px] text-slate-500 uppercase tracking-widest font-bold block mb-1">Language</span>
          <span class="text-xl font-bold text-cyan-400">Python <span class="text-white">91.9%</span></span>
        </div>
        <div class="bg-white/[0.02] border border-white/5 p-5 rounded-2xl backdrop-blur-sm">
          <span class="text-[10px] text-slate-500 uppercase tracking-widest font-bold block mb-1">Architecture</span>
          <span class="text-xl font-bold text-emerald-400">Monorepo</span>
        </div>
        <div class="bg-white/[0.02] border border-white/5 p-5 rounded-2xl backdrop-blur-sm">
          <span class="text-[10px] text-slate-500 uppercase tracking-widest font-bold block mb-1">Security</span>
          <span class="text-xl font-bold text-purple-400">Shift-Left</span>
        </div>
        <div class="bg-white/[0.02] border border-white/5 p-5 rounded-2xl backdrop-blur-sm">
          <span class="text-[10px] text-slate-500 uppercase tracking-widest font-bold block mb-1">License</span>
          <span class="text-xl font-bold text-orange-400">MIT</span>
        </div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section class="py-24 relative z-10 border-y border-white/5 bg-slate-900/40 backdrop-blur-sm">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2
        class="text-3xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-300 mb-6"
      >
        Why VEXiL?
      </h2>
      <p class="text-slate-300 text-lg leading-relaxed">
        The name VEXiL is a nod to <strong class="text-white font-bold bg-white/10 px-2 py-0.5 rounded"
          >Vector Expression Language (VEX)</strong
        >, an essential part of the Houdini ecosystem. Prevailing project management utilities often prioritize
        top-down, executive-level features and treat Houdini workflows as disconnected file creations. VEXiL bridges
        this gap. It is a high-performance framework dedicated strictly to your VFX pipeline, leveraging Houdini's
        native capabilities rather than ignoring them.
      </p>
    </div>
  </section>

  <!-- Features Grid -->
  <section id="features" class="py-24 px-6 max-w-7xl mx-auto relative z-10">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-extrabold text-white mb-4">Core Capabilities</h2>
      <p class="text-slate-300 text-lg">Quality-of-life features built for the VFX professional.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-left">
      <!-- Feature 1 -->
      <div
        class="bg-white/[0.02] border border-white/5 p-8 rounded-3xl hover:border-cyan-500/30 hover:bg-white/[0.04] transition-all duration-300 hover:-translate-y-1 group shadow-lg"
      >
        <div
          class="w-14 h-14 bg-gradient-to-br from-cyan-400 to-blue-600 rounded-xl flex items-center justify-center text-white mb-6 group-hover:scale-110 group-hover:rotate-3 transition-transform shadow-[0_0_15px_rgba(34,211,238,0.4)]"
        >
          <Icon name="lucide:terminal" class="w-7 h-7" />
        </div>
        <h3 class="text-xl font-bold text-white mb-3">Seamless Houdini Integration</h3>
        <p class="text-slate-400 leading-relaxed">
          Automate your workflows with a simple Houdini package installation. By leveraging OpenTimelineIO (OTIO)
          integration, VEXiL automatically synchronizes audio, sequence scenes, reference imagery, and temporal
          overlaps directly within Houdini.
        </p>
      </div>

      <!-- Feature 2 -->
      <div
        class="bg-white/[0.02] border border-white/5 p-8 rounded-3xl hover:border-purple-500/30 hover:bg-white/[0.04] transition-all duration-300 hover:-translate-y-1 group shadow-lg"
      >
        <div
          class="w-14 h-14 bg-gradient-to-br from-purple-400 to-fuchsia-600 rounded-xl flex items-center justify-center text-white mb-6 group-hover:scale-110 group-hover:-rotate-3 transition-transform shadow-[0_0_15px_rgba(192,38,211,0.4)]"
        >
          <Icon name="lucide:layers" class="w-7 h-7" />
        </div>
        <h3 class="text-xl font-bold text-white mb-3">Intuitive Web Interface</h3>
        <p class="text-slate-400 leading-relaxed">
          Architect folder structures, manage external assets, and configure global defaults from a dedicated browser
          portal. This includes a custom node-network editor to visually streamline the design of your Houdini
          workflows.
        </p>
      </div>

      <!-- Feature 3 -->
      <div
        class="bg-white/[0.02] border border-white/5 p-8 rounded-3xl hover:border-pink-500/30 hover:bg-white/[0.04] transition-all duration-300 hover:-translate-y-1 group shadow-lg"
      >
        <div
          class="w-14 h-14 bg-gradient-to-br from-pink-400 to-orange-500 rounded-xl flex items-center justify-center text-white mb-6 group-hover:scale-110 group-hover:rotate-3 transition-transform shadow-[0_0_15px_rgba(244,63,94,0.4)]"
        >
          <Icon name="lucide:share-2" class="w-7 h-7" />
        </div>
        <h3 class="text-xl font-bold text-white mb-3">Community Exchange "Recipes"</h3>
        <p class="text-slate-400 leading-relaxed">
          While your projects remain private and encrypted by default, you have the option to contribute to or access
          shared Houdini networks—known as community "Recipes" to accelerate your pipeline.
        </p>
      </div>

      <!-- Feature 4 -->
      <div
        class="bg-white/[0.02] border border-white/5 p-8 rounded-3xl hover:border-emerald-500/30 hover:bg-white/[0.04] transition-all duration-300 hover:-translate-y-1 group shadow-lg"
      >
        <div
          class="w-14 h-14 bg-gradient-to-br from-emerald-400 to-teal-600 rounded-xl flex items-center justify-center text-white mb-6 group-hover:scale-110 group-hover:-rotate-3 transition-transform shadow-[0_0_15px_rgba(52,211,153,0.4)]"
        >
          <Icon name="lucide:shield-check" class="w-7 h-7" />
        </div>
        <h3 class="text-xl font-bold text-white mb-3">Secure Client Collaboration</h3>
        <p class="text-slate-400 leading-relaxed">
          Security is embedded by design. Safely share assets for client review and feedback via custom-branded
          project windows, ensuring restricted access to sensitive project files.
        </p>
      </div>
    </div>
  </section>

  <!-- Deployment Section -->
  <section id="deployment" class="py-24 relative border-y border-white/5 bg-slate-900/40 backdrop-blur-sm z-10">
    <div class="max-w-5xl mx-auto px-6 text-center">
      <h2 class="text-3xl font-extrabold text-white mb-4">Built for Flexibility. Rooted in Open Source.</h2>
      <p class="text-slate-300 mb-16 max-w-2xl mx-auto text-lg">
        We believe in an accessible VFX ecosystem, which is why the primary VEXiL codebase is distributed under the
        MIT License.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div
          class="bg-slate-950/80 border border-white/5 p-8 rounded-3xl text-left shadow-xl hover:border-white/10 transition-colors"
        >
          <div class="flex items-center gap-4 mb-4">
            <div class="p-3 bg-blue-500/10 rounded-lg text-blue-400">
              <Icon name="lucide:hard-drive" class="w-7 h-7" />
            </div>
            <h3 class="text-xl font-bold text-white">Self-Hosted (Docker)</h3>
          </div>
          <p class="text-slate-400">
            Retain complete oversight of your infrastructure and meet stringent data residency needs with easy
            deployment via Docker Compose.
          </p>
        </div>

        <div
          class="bg-slate-950/80 border border-white/5 p-8 rounded-3xl text-left shadow-xl hover:border-white/10 transition-colors"
        >
          <div class="flex items-center gap-4 mb-4">
            <div class="p-3 bg-cyan-500/10 rounded-lg text-cyan-400">
              <Icon name="lucide:cloud" class="w-7 h-7" />
            </div>
            <h3 class="text-xl font-bold text-white">Managed Cloud Platform</h3>
          </div>
          <p class="text-slate-400">
            Prefer not to manage servers? Our managed platform serves as your online endpoint, unlocking long-term
            archiving via Amazon Glacier and seamless tracking of project progress.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Stack & Orchestration (for contributors) -->
  <section
    id="contribute"
    class="py-24 px-6 max-w-7xl mx-auto relative z-10 scroll-mt-20"
  >
    <div class="text-center mb-16">
      <span
        class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/30 text-cyan-300 text-xs uppercase tracking-widest font-bold mb-4"
      >
        <Icon name="lucide:code" class="w-3.5 h-3.5" /> For contributors
      </span>
      <h2 class="text-4xl font-extrabold text-white mb-4 flex items-center justify-center gap-3">
        <Icon name="lucide:cpu" class="text-cyan-400 w-8 h-8" /> Technical Stack & Orchestration
      </h2>
      <p class="text-slate-300 text-lg max-w-3xl mx-auto leading-relaxed">
        VEXiL is an MIT-licensed monorepo: <strong class="text-white">Bun + Turborepo</strong> orchestrate the JS
        workspaces, <strong class="text-white">uv</strong> manages every Python project. Five workspaces, one root
        install, one dev command.
      </p>
    </div>

    <!-- Repo tree -->
    <div
      class="bg-slate-950/80 border border-cyan-500/20 rounded-3xl p-6 md:p-8 mb-12 shadow-[0_0_40px_rgba(34,211,238,0.08)] overflow-x-auto"
    >
      <div class="flex items-center justify-between mb-4">
        <span class="text-xs text-slate-500 uppercase tracking-widest font-bold flex items-center gap-2">
          <Icon name="lucide:folder-tree" class="w-4 h-4" /> Repository Layout
        </span>
        <a
          href="https://github.com/anhedonix/vexil"
          target="_blank"
          rel="noreferrer"
          class="text-xs text-cyan-400 hover:text-cyan-300 transition-colors flex items-center gap-1"
        >
          anhedonix/vexil <Icon name="lucide:arrow-up-right" class="w-3.5 h-3.5" />
        </a>
      </div>
      <pre
        class="text-xs md:text-sm leading-relaxed font-mono m-0"
        set:html={repoTree}
      />
    </div>

    <!-- Workspace grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      <!-- apps/website -->
      <div class="bg-white/[0.02] border border-white/5 p-6 rounded-3xl hover:border-cyan-500/30 transition-colors">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <Icon name="lucide:globe" class="w-5 h-5 text-cyan-400" />
            <span class="text-xs text-slate-500 uppercase tracking-wider font-mono">apps/website</span>
          </div>
          <span
            class="text-[9px] px-2 py-0.5 rounded-md uppercase font-bold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30"
            >Built</span
          >
        </div>
        <h3 class="text-lg font-bold text-white mb-2">Marketing Site</h3>
        <p class="text-sm text-slate-400 mb-4 leading-relaxed">
          Static landing page (this site). Generated at build time, deployable to Vercel, Netlify, or Cloudflare Pages.
        </p>
        <div class="flex flex-wrap gap-1.5">
          <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-cyan-500/10 text-cyan-300 border border-cyan-500/20"
            >Astro 6</span
          >
          <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-cyan-500/10 text-cyan-300 border border-cyan-500/20"
            >Tailwind v4</span
          >
          <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-cyan-500/10 text-cyan-300 border border-cyan-500/20"
            >astro-icon</span
          >
          <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-cyan-500/10 text-cyan-300 border border-cyan-500/20"
            >TypeScript</span
          >
        </div>
      </div>

      <!-- apps/frontend -->
      <div class="bg-white/[0.02] border border-white/5 p-6 rounded-3xl hover:border-purple-500/30 transition-colors">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <Icon name="lucide:layout" class="w-5 h-5 text-purple-400" />
            <span class="text-xs text-slate-500 uppercase tracking-wider font-mono">apps/frontend</span>
          </div>
          <span
            class="text-[9px] px-2 py-0.5 rounded-md uppercase font-bold bg-blue-500/15 text-blue-400 border border-blue-500/30"
            >Scaffold</span
          >
        </div>
        <h3 class="text-lg font-bold text-white mb-2">Product Web UI</h3>
        <p class="text-sm text-slate-400 mb-4 leading-relaxed">
          The authenticated browser portal — folder layouts, asset management, node-network editor. Skeleton
          committed; feature work open for contributions.
        </p>
        <div class="flex flex-wrap gap-1.5">
          <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-purple-500/10 text-purple-300 border border-purple-500/20"
            >Astro 6</span
          >
          <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-slate-700/30 text-slate-400 border border-white/10"
            >UI library · planned</span
          >
        </div>
      </div>

      <!-- apps/backend -->
      <div class="bg-white/[0.02] border border-white/5 p-6 rounded-3xl hover:border-emerald-500/30 transition-colors">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <Icon name="lucide:server" class="w-5 h-5 text-emerald-400" />
            <span class="text-xs text-slate-500 uppercase tracking-wider font-mono">apps/backend</span>
          </div>
          <span
            class="text-[9px] px-2 py-0.5 rounded-md uppercase font-bold bg-blue-500/15 text-blue-400 border border-blue-500/30"
            >Scaffold</span
          >
        </div>
        <h3 class="text-lg font-bold text-white mb-2">Core API</h3>
        <p class="text-sm text-slate-400 mb-4 leading-relaxed">
          Django project managed by uv. Currently SQLite + standard auth; GraphQL layer and Postgres (AWS RDS) arrive
          in Phase II.
        </p>
        <div class="flex flex-wrap gap-1.5">
          <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-300 border border-emerald-500/20"
            >Django 6</span
          >
          <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-300 border border-emerald-500/20"
            >uv</span
          >
          <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-300 border border-emerald-500/20"
            >Python ≥3.14</span
          >
          <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-slate-700/30 text-slate-400 border border-white/10"
            >GraphQL · planned</span
          >
        </div>
      </div>

      <!-- apps/houdini-package -->
      <div class="bg-white/[0.02] border border-white/5 p-6 rounded-3xl hover:border-pink-500/30 transition-colors">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <Icon name="lucide:box" class="w-5 h-5 text-pink-400" />
