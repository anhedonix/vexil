<script>
  // Theme toggle
  const themeToggle = document.getElementById('theme-toggle');
  const root = document.documentElement;

  const setTheme = (theme: 'dark' | 'light') => {
    root.setAttribute('data-theme', theme);
    try {
      localStorage.setItem('vexil-theme', theme);
    } catch (_) {
      /* ignore */
    }
  };

  themeToggle?.addEventListener('click', () => {
    const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    setTheme(next);
  });

  // Nav logo → smooth scroll to top
  document.getElementById('nav-logo')?.addEventListener('click', (e) => {
    e.preventDefault();
    window.scrollTo({ top: 0, behavior: 'smooth' });
    history.replaceState(null, '', '#top');
  });

  // Waitlist form
  const form = document.getElementById('waitlist-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('waitlist-submit') as HTMLButtonElement | null;
  const successCard = document.getElementById('waitlist-success');
  const errorBox = document.getElementById('waitlist-error');

  if (form && submitBtn && successCard && errorBox) {
    const idleEl = submitBtn.querySelector<HTMLElement>('[data-state="idle"]');
    const loadingEl = submitBtn.querySelector<HTMLElement>('[data-state="loading"]');
    const errorMsg = errorBox.querySelector<HTMLElement>('[data-error-message]');

    const setLoading = (loading: boolean) => {
      submitBtn.disabled = loading;
      if (idleEl) idleEl.classList.toggle('hidden', loading);
      if (loadingEl) {
        loadingEl.classList.toggle('hidden', !loading);
        loadingEl.classList.toggle('inline-flex', loading);
      }
    };

    const showError = (message: string) => {
      if (errorMsg) errorMsg.textContent = message;
      errorBox.classList.remove('hidden');
      errorBox.classList.add('flex');
    };

    const hideError = () => {
      errorBox.classList.add('hidden');
      errorBox.classList.remove('flex');
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }

      hideError();
      setLoading(true);

      const data = new FormData(form);
      const payload = {
        email: data.get('email'),
        userType: data.get('userType'),
        comments: data.get('comments'),
      };

      try {
        const res = await fetch('/api/waitlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const body = (await res.json().catch(() => ({}))) as { ok?: boolean; error?: string };
        if (!res.ok || !body.ok) {
          throw new Error(body.error || 'Submission failed. Please try again.');
        }

        form.classList.add('hidden');
        successCard.classList.remove('hidden');
        successCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch (err) {
        showError(err instanceof Error ? err.message : 'Submission failed. Please try again.');
        setLoading(false);
      }
    });
  }
</script>
