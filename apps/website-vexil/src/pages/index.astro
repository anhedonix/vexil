---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';

const repoTree = `<span class="text-brand-cyan">vexil/</span>
├── <span class="text-secondary">apps/</span>
│   ├── <span class="text-[var(--success)]">website-vexil/</span>              <span class="text-secondary">- website (Astro 7 · Tailwind v4)</span>
│   ├── <span class="text-[var(--success)]">frontend-app/</span>               <span class="text-secondary">- product web UI (Astro 7)</span>
│   ├── <span class="text-[var(--success)]">backend-api/</span>                <span class="text-secondary">- core API (<span class="lang-name">Go</span> · RestAPI)</span>
│   └── <span class="text-secondary">plugins/</span>
│       └── <span class="text-[var(--success)]">houdini-package/</span>      <span class="text-secondary">- Houdini plugin (uv · <span class="lang-name">Python 3.13</span>)</span>
└── <span class="text-secondary">dev-tools/</span>
    └── <span class="text-[var(--success)]">env-init/</span>                  <span class="text-secondary">- environment setup using specific tools for developers</span>`;

const quickstart = `<span class="text-secondary"># 1. Clone and hydrate the JS workspaces</span>
git clone https://github.com/anhedonix/vexil
cd vexil
bun install

<span class="text-secondary"># 2. Run every dev server in parallel (Turborepo)</span>
bun run dev

<span class="text-secondary"># 3. Sync Python workspaces and download Go modules</span>
bun run setup`;

const chip =
  'text-[10px] font-medium uppercase tracking-wider px-2 py-0.5 rounded-[2px] bg-surface-2 text-secondary border border-theme font-mono';
const langChip =
  'text-[10px] font-medium uppercase tracking-wider px-2 py-0.5 rounded-[2px] bg-surface-2 border border-theme font-mono lang-name';
---

<Layout>
  <!-- Navigation -->
  <nav class="border-b border-theme bg-base/90 backdrop-blur-md sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
      <a href="#top" id="nav-logo" class="flex items-center shrink-0" aria-label="Back to top">
        <img
          src="/vexil-mark.png"
          alt="VEXiL"
          class="h-14 w-14 object-contain"
          width="56"
          height="56"
        />
      </a>
      <div class="flex items-center gap-3 sm:gap-5 text-sm font-medium">
        <a href="#features" class="text-secondary hover:text-primary transition-colors duration-150 hidden sm:block"
          >Features</a
        >
        <a href="#deployment" class="text-secondary hover:text-primary transition-colors duration-150 hidden sm:block"
          >Deployment</a
        >
        <a href="#waitlist" class="text-secondary hover:text-primary transition-colors duration-150 hidden md:block"
          >Waitlist</a
        >
        <button
          type="button"
          id="theme-toggle"
          class="inline-flex items-center justify-center size-9 rounded-[4px] border border-theme bg-surface-1 text-secondary hover:text-primary hover:bg-surface-2 transition-colors duration-150"
          aria-label="Toggle color theme"
        >
          <Icon name="lucide:sun" class="theme-icon-sun w-4 h-4" />
          <Icon name="lucide:moon" class="theme-icon-moon w-4 h-4" />
        </button>
        <a
          href="https://github.com/anhedonix/vexil"
          target="_blank"
          rel="noreferrer"
          class="flex items-center gap-2 bg-surface-1 hover:bg-surface-2 border border-theme text-primary px-3 py-2 rounded-[4px] transition-colors duration-150 text-sm"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"
            ><path
              d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
            ></path></svg
          >
          <span class="hidden sm:inline">GitHub</span>
        </a>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative pt-20 pb-24 px-4 sm:px-6 overflow-hidden">
    <div class="hero-wash pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="max-w-3xl mx-auto text-center relative z-10 flex flex-col items-center">
      <img
        src="/vexil-wordmark.png"
        alt="VEXiL"
        class="h-32 w-auto mb-8 object-contain"
        width="384"
        height="128"
      />

      <p class="text-xs font-medium uppercase tracking-widest text-secondary mb-4 font-mono">
        Public beta · coming soon
      </p>

      <h1 class="text-4xl md:text-[2rem] lg:text-[2.5rem] font-semibold tracking-tight text-primary mb-4 leading-tight">
        Pipeline-aware project management<br class="hidden sm:block" />
        <span class="text-brand-gradient">built for Houdini.</span>
      </h1>

      <p class="text-base md:text-lg text-secondary mb-10 max-w-xl leading-relaxed">
        VEXiL is a SideFX Houdini-first project management environment for freelancers, indie studios, and TDs - with
        pipeline depth for sequences, frame ranges, and dependency graphs. Other DCC integrations (Maya, Nuke, Blender)
        may follow later.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 w-full sm:w-auto">
        <a
          href="#waitlist"
          class="group flex items-center justify-center gap-2 bg-brand-gradient hover:brightness-110 active:brightness-90 text-white px-6 py-3 rounded-[4px] font-semibold transition-[filter] duration-150"
        >
          Join the Waitlist
          <Icon name="lucide:chevron-down" class="w-4 h-4" />
        </a>
        <a
          href="https://github.com/anhedonix/vexil"
          target="_blank"
          rel="noreferrer"
          class="flex items-center justify-center gap-2 bg-surface-1 hover:bg-surface-2 border border-theme text-primary px-6 py-3 rounded-[4px] font-semibold transition-colors duration-150"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"
            ><path
              d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
            ></path></svg
          >
          View Source
        </a>
      </div>

      <p class="mt-12 text-xs text-secondary font-mono">
        <span class="lang-name">Python</span> &amp; <span class="lang-name">Go</span> · MIT · Shift-Left security
      </p>
    </div>
  </section>

  <!-- Why VEXiL -->
  <section class="py-16 sm:py-24 relative z-10 border-y border-theme bg-surface-1 bg-brand-wash">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-lg font-medium text-primary mb-4">Why VEXiL?</h2>
      <p class="text-secondary text-base leading-relaxed">
        The name is a direct homage to
        <strong class="text-primary font-semibold">Vector Expression Language (VEX)</strong>
        - the high-performance language at the heart of
        <strong class="text-primary font-semibold">SideFX Houdini</strong>.
        Generic project-management tools treat VFX work as disconnected file creations.
        <strong class="text-primary font-semibold">VEXiL</strong>
        starts inside Houdini, with pipeline-aware depth for sequences, frame ranges, and dependency graphs.
        Other DCCs (Maya, Nuke, Blender) may follow later.
      </p>
    </div>
  </section>

  <!-- Features -->
  <section id="features" class="py-16 sm:py-24 px-4 sm:px-6 max-w-7xl mx-auto relative z-10 scroll-mt-20">
    <div class="text-center mb-12">
      <h2 class="text-2xl font-semibold text-primary tracking-tight">Core Capabilities</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-left">
      <div class="bg-surface-1 border border-theme p-6 rounded-[4px] bg-brand-wash hover:bg-surface-2 transition-colors duration-150">
        <div class="icon-tile icon-tile--lg mb-4">
          <Icon name="lucide:terminal" class="w-5 h-5" />
        </div>
        <div class="flex items-center justify-between gap-2 mb-2">
          <h3 class="text-base font-semibold text-primary">Deep Houdini Integration</h3>
          <span
            class="text-[10px] px-2 py-0.5 rounded-[2px] uppercase font-medium font-mono bg-surface-2 text-brand-cyan border border-theme whitespace-nowrap"
            >Houdini first</span
          >
        </div>
        <p class="text-secondary text-sm leading-relaxed">
          A single Houdini package install wires VEXiL into your scenes.
          <strong class="text-primary font-semibold">VEXiL-UI</strong>
          (<span class="lang-name">PySide6</span>) sits beside HOM with a
          <span class="lang-name">Python</span>
          bridge - scene structure, versions, and pipeline depth no general-purpose PM tool can reach.
        </p>
      </div>

      <div class="bg-surface-1 border border-theme p-6 rounded-[4px] bg-brand-wash hover:bg-surface-2 transition-colors duration-150">
        <div class="icon-tile icon-tile--lg mb-4">
          <Icon name="lucide:layers" class="w-5 h-5" />
        </div>
        <h3 class="text-base font-semibold text-primary mb-2">Web Interface &amp; Node Networks</h3>
        <p class="text-secondary text-sm leading-relaxed">
          Architect folder structures, manage external assets, and configure defaults from a browser portal.
          Includes a custom
          <strong class="text-primary font-semibold">node-network editor</strong>
          for visual workflows and
          <strong class="text-primary font-semibold">reusable node-graph</strong>
          exchange.
        </p>
      </div>

      <div class="bg-surface-1 border border-theme p-6 rounded-[4px] bg-brand-wash hover:bg-surface-2 transition-colors duration-150">
        <div class="icon-tile icon-tile--lg mb-4">
          <Icon name="lucide:share-2" class="w-5 h-5" />
        </div>
        <h3 class="text-base font-semibold text-primary mb-2">Community Reusable Node-Graphs</h3>
        <p class="text-secondary text-sm leading-relaxed">
          Projects stay private and encrypted by default. Opt in to contribute or pull shared
          <strong class="text-primary font-semibold">community node-graphs</strong>
          to accelerate your
          <strong class="text-primary font-semibold">Houdini</strong>
          pipeline.
        </p>
      </div>

      <div class="bg-surface-1 border border-theme p-6 rounded-[4px] bg-brand-wash hover:bg-surface-2 transition-colors duration-150">
        <div class="icon-tile icon-tile--lg mb-4">
          <Icon name="lucide:shield-check" class="w-5 h-5" />
        </div>
        <h3 class="text-base font-semibold text-primary mb-2">Secure Client Collaboration</h3>
        <p class="text-secondary text-sm leading-relaxed">
          Share for review via
          <strong class="text-primary font-semibold">branded project windows</strong>
          with restricted access - or keep it local with
          <strong class="text-primary font-semibold">watermarked PDF</strong>
          packages.
          <strong class="text-primary font-semibold">Encrypted metadata</strong>
          and
          <strong class="text-primary font-semibold">Shift-Left</strong>
          security are built into the protocol.
        </p>
      </div>
    </div>
  </section>

  <!-- Deployment -->
  <section id="deployment" class="py-16 sm:py-24 relative border-y border-theme bg-surface-1 bg-brand-wash z-10 scroll-mt-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center">
      <h2 class="text-2xl font-semibold text-primary mb-2 tracking-tight">Flexible Deployment. Open Source Core.</h2>
      <p class="text-secondary mb-12 max-w-2xl mx-auto text-base">
        The primary VEXiL codebase is distributed under the MIT License.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-left">
        <div class="bg-base border border-theme p-6 rounded-[4px]">
          <div class="flex items-center gap-3 mb-3">
            <div class="icon-tile">
              <Icon name="lucide:monitor" class="w-5 h-5" />
            </div>
            <h3 class="text-base font-semibold text-primary">Local (Docker)</h3>
          </div>
          <p class="text-secondary text-sm leading-relaxed">
            For solo artists on a single machine - run everything locally with Docker and manage projects without
            paying for extra services.
          </p>
        </div>

        <div class="bg-base border border-theme p-6 rounded-[4px]">
          <div class="flex items-center gap-3 mb-3">
            <div class="icon-tile">
              <Icon name="lucide:hard-drive" class="w-5 h-5" />
            </div>
            <h3 class="text-base font-semibold text-primary">Self-Hosted (Studio)</h3>
          </div>
          <p class="text-secondary text-sm leading-relaxed">
            For a local team on a LAN: host the API on a small machine - even a Raspberry Pi - so every seat stays in
            sync from one place.
          </p>
        </div>

        <div class="bg-base border border-theme p-6 rounded-[4px]">
          <div class="flex items-center gap-3 mb-3">
            <div class="icon-tile">
              <Icon name="lucide:cloud" class="w-5 h-5" />
            </div>
            <h3 class="text-base font-semibold text-primary">Managed Cloud</h3>
          </div>
          <p class="text-secondary text-sm leading-relaxed">
            We host VEXiL for our own pipelines. For a small fee, we can run the infrastructure for you - install the
            plugin and start working, with no technical setup.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Stack -->
  <section id="contribute" class="py-16 sm:py-24 px-4 sm:px-6 max-w-7xl mx-auto relative z-10 scroll-mt-20">
    <div class="text-center mb-12">
      <span
        class="inline-flex items-center gap-2 px-2.5 py-1 rounded-[2px] bg-surface-1 border border-theme text-secondary text-[10px] uppercase tracking-widest font-medium font-mono mb-4"
      >
        <Icon name="lucide:code" class="w-3.5 h-3.5 text-brand-cyan" /> For developers
      </span>
      <h2 class="text-2xl font-semibold text-primary mb-3 tracking-tight">Technical Stack &amp; Orchestration</h2>
      <p class="text-secondary text-base max-w-3xl mx-auto leading-relaxed">
        For developers and anyone interested in contributing - a quick bird's-eye view of how this project is set up.
      </p>
    </div>

    <div class="bg-surface-1 border border-theme rounded-[4px] p-4 sm:p-6 mb-8 overflow-x-auto bg-brand-wash">
      <div class="flex items-center justify-between mb-4">
        <span class="text-[10px] text-secondary uppercase tracking-widest font-medium font-mono flex items-center gap-2">
          <span class="icon-tile !p-1.5"><Icon name="lucide:folder-tree" class="w-3.5 h-3.5" /></span> Repository Layout
        </span>
        <a
          href="https://github.com/anhedonix/vexil"
          target="_blank"
          rel="noreferrer"
          class="text-xs text-brand-cyan hover:text-brand-blue transition-colors duration-150 flex items-center gap-1 font-mono"
        >
          anhedonix/vexil <Icon name="lucide:arrow-up-right" class="w-3.5 h-3.5" />
        </a>
      </div>
      <pre class="text-xs md:text-sm leading-[1rem] font-mono m-0 text-primary" set:html={repoTree} />
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
      <div class="bg-surface-1 border border-theme p-5 rounded-[4px]">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <div class="icon-tile !p-1.5"><Icon name="lucide:globe" class="w-4 h-4" /></div>
            <span class="text-xs text-secondary uppercase tracking-wider font-mono">apps/website-vexil</span>
          </div>
          <span
            class="text-[10px] px-2 py-0.5 rounded-[2px] uppercase font-medium font-mono bg-surface-2 text-[var(--success)] border border-theme"
            >Built</span
          >
        </div>
        <h3 class="text-base font-semibold text-primary mb-2">Website-VEXiL</h3>
        <p class="text-sm text-secondary mb-4 leading-relaxed">
          Built with
          <strong class="text-primary font-semibold">Astro</strong>
          - the public site for product introduction today; documentation will live here as the project matures.
          Deployable to Vercel, Netlify, or Cloudflare Pages.
        </p>
        <div class="flex flex-wrap gap-1.5">
          <span class={chip}>Astro</span>
        </div>
      </div>

      <div class="bg-surface-1 border border-theme p-5 rounded-[4px]">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <div class="icon-tile !p-1.5"><Icon name="lucide:server" class="w-4 h-4" /></div>
            <span class="text-xs text-secondary uppercase tracking-wider font-mono">apps/backend-api</span>
          </div>
          <span
            class="text-[10px] px-2 py-0.5 rounded-[2px] uppercase font-medium font-mono bg-surface-2 text-brand-cyan border border-theme"
            >Scaffold</span
          >
        </div>
        <h3 class="text-base font-semibold text-primary mb-2">Core API</h3>
        <p class="text-sm text-secondary mb-4 leading-relaxed">
          <span class="lang-name">Go</span>'s speed and build velocity power a full
          <strong class="text-primary font-semibold">RestAPI</strong>
          on
          <strong class="text-primary font-semibold">Gin</strong>
          - robust, easy to manage, and dedicated to system
          <strong class="text-primary font-semibold">I/O</strong>.
          VEXiL inside Houdini talks to this listener for file and OS work.
          One binary compiles for
          <strong class="text-primary font-semibold">Linux</strong>
          (our primary target),
          <strong class="text-primary font-semibold">macOS</strong>, and
          <strong class="text-primary font-semibold">Windows</strong>,
          so the same Houdini package runs across platforms.
        </p>
        <div class="flex flex-wrap gap-1.5">
          <span class={langChip}>Go</span>
          <span class={chip}>Gin</span>
          <span class={chip}>RestAPI</span>
        </div>
      </div>

      <div class="bg-surface-1 border border-theme p-5 rounded-[4px]">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <div class="icon-tile !p-1.5"><Icon name="lucide:box" class="w-4 h-4" /></div>
            <span class="text-xs text-secondary uppercase tracking-wider font-mono">apps/plugins/houdini-package</span>
          </div>
          <span
            class="text-[10px] px-2 py-0.5 rounded-[2px] uppercase font-medium font-mono bg-surface-2 text-brand-cyan border border-theme"
            >Scaffold</span
          >
        </div>
        <h3 class="text-base font-semibold text-primary mb-2">Houdini Plugin</h3>
        <p class="text-sm text-secondary mb-4 leading-relaxed">
          The Houdini package is mainly
          <span class="lang-name">Python</span>
          3.13 and targets
          <strong class="text-primary font-semibold">Houdini 22+</strong>
          only. Scene work goes through
          <span class="lang-name">Python</span>
          talking directly to the
          <code class="font-mono text-xs text-brand-cyan bg-base px-1 py-0.5 rounded-[2px]">hou</code>
          module (HOM).
        </p>
        <div class="flex flex-wrap gap-1.5">
          <span class={langChip}>Python 3.13</span>
          <span class={chip}>Houdini 22+</span>
          <span class={chip}>hou</span>
        </div>
      </div>

      <div class="bg-surface-1 border border-theme p-5 rounded-[4px]">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <div class="icon-tile !p-1.5"><Icon name="lucide:terminal" class="w-4 h-4" /></div>
            <span class="text-xs text-secondary uppercase tracking-wider font-mono">dev-tools/env-init</span>
          </div>
          <span
            class="text-[10px] px-2 py-0.5 rounded-[2px] uppercase font-medium font-mono bg-surface-2 text-brand-cyan border border-theme"
            >Scaffold</span
          >
        </div>
        <h3 class="text-base font-semibold text-primary mb-2">Developer UI</h3>
        <p class="text-sm text-secondary mb-4 leading-relaxed">
          Custom
          <strong class="text-primary font-semibold">TUIs</strong>
          and
          <strong class="text-primary font-semibold">GUIs</strong>
          help developers set up the environment and get productive quickly.
          Documentation will follow as time allows.
        </p>
        <div class="flex flex-wrap gap-1.5">
          <span class={chip}>TUI</span>
          <span class={chip}>GUI</span>
        </div>
      </div>

      <div class="bg-surface-1 border border-theme border-brand-cyan/40 p-5 rounded-[4px]">
        <div class="flex items-center justify-between mb-3">
          <div class="flex items-center gap-2">
            <div class="icon-tile !p-1.5"><Icon name="lucide:git-branch" class="w-4 h-4" /></div>
            <span class="text-xs text-secondary uppercase tracking-wider font-mono">root</span>
          </div>
          <span
            class="text-[10px] px-2 py-0.5 rounded-[2px] uppercase font-medium font-mono bg-surface-2 text-[var(--success)] border border-theme"
            >Built</span
          >
        </div>
        <h3 class="text-base font-semibold text-primary mb-2">Orchestration</h3>
        <p class="text-sm text-secondary mb-4 leading-relaxed">
          This repo is a
          <strong class="text-primary font-semibold">monorepo</strong>.
          After trying a few tools,
          <strong class="text-primary font-semibold">Turborepo</strong>
          fit the workflow, with
          <strong class="text-primary font-semibold">Bun</strong>
          for package management.
          Neither is part of the Houdini package - they orchestrate the frontend and JS workspaces only - so the
          choice stays independent of the plugin.
        </p>
        <div class="flex flex-wrap gap-1.5">
          <span class={chip}>Monorepo</span>
          <span class={chip}>Turborepo</span>
          <span class={chip}>Bun</span>
        </div>
      </div>

