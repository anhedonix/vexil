load("@rules_python//python:defs.bzl", "py_binary", "py_library")

# This BUILD file assumes you are using rules_python's integration 
# with uv-generated requirements.txt or pyproject.toml

py_library(
    name = "backend_lib",
    srcs = glob(
        ["**/*.py"],
        exclude = ["manage.py", "tests/**"],
    ),
    visibility = ["//visibility:public"],
    deps = [
        # Dependencies are typically managed via pip.parse in MODULE.bazel
        # referencing the uv-lock generated requirements
        # "@python_deps//django",
    ],
)

py_binary(
    name = "manage",
    srcs = ["manage.py"],
    main = "manage.py",
    deps = [
        ":backend_lib",
    ],
)
